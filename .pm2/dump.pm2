  {
    "name": "zdos-omni-nexus",
    "filter_env": [],
    "namespace": "default",
    "env": {
      "SHELL": "/bin/bash",
      "SUDO_GID": "0",
      "SUDO_COMMAND": "/usr/bin/bash -c \nset -e\nNEXUS_DIR=\"/opt/zdos-omni-nexus\"\nmkdir -p \"$NEXUS_DIR/public\" && cd \"$NEXUS_DIR\"\n\n# 1. Crea package.json e installa dipendenze\ncat << \"EOF\" > package.json\n{\n  \"name\": \"zdos-omni-nexus\",\n  \"version\": \"2.1.0\",\n  \"main\": \"nexus.js\",\n  \"scripts\": { \"start\": \"node nexus.js\" },\n  \"dependencies\": {\n    \"whatsapp-web.js\": \"^1.26.0\",\n    \"qrcode\": \"^1.5.4\",\n    \"qrcode-terminal\": \"^0.12.0\",\n    \"discord.js\": \"^14.16.3\",\n    \"node-telegram-bot-api\": \"^0.66.0\",\n    \"twitter-api-v2\": \"^1.18.2\",\n    \"express\": \"^4.21.1\",\n    \"socket.io\": \"^4.8.1\",\n    \"dotenv\": \"^16.4.5\"\n  }\n}\nEOF\n\nnpm install --no-audit --no-fund\n\n# 2. Crea .env (mantiene il tuo se esiste già)\nif [ ! -f .env ]; then\ncat << \"EOF\" > .env\nPORT=8899\nNEXUS_SECRET=ZDOS2026\nDISCORD_TOKEN=\nDISCORD_AMPLIFY_CHANNEL_ID=\nDISCORD_LODGE_CHANNEL_ID=\nWA_CHANNEL_INVITE=0029Vb9Rbee89inrYLhdem1n\nWA_INVITE_LODGE=ICy1XD6l6N35ZJwECYQ2oO\nWA_INVITE_NOVA=CvdIbtU721g7iupPXb2lQt\nTELEGRAM_TOKEN=\nTELEGRAM_CHANNEL=@ourvelvet\nX_APP_KEY=\nX_APP_SECRET=\nX_ACCESS_TOKEN=\nX_ACCESS_SECRET=\nEOF\nfi\n\n# 3. Crea War Room Web UI\ncat << \"EOF\" > public/index.html\n<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>ZDOS // OMNI-NEXUS WAR ROOM</title>\n  <script src=\"/socket.io/socket.io.js\"></script>\n  <style>\n    body { background: #07070b; color: #e2e8f0; font-family: monospace; margin: 0; padding: 20px; }\n    h1 { color: #ef4444; }\n    .card { background: #0f1016; border: 1px solid #27273a; border-radius: 8px; padding: 16px; margin-bottom: 16px; }\n    textarea { width: 100%; height: 90px; background: #050508; color: #fff; border: 1px solid #3f3f5a; padding: 8px; box-sizing: border-box; }\n    button { background: #b91c1c; color: #fff; border: none; padding: 12px; width: 100%; font-weight: bold; cursor: pointer; margin-top: 8px; }\n    #logs { height: 220px; overflow-y: auto; background: #040406; padding: 10px; font-size: 12px; }\n    #qr-box img { max-width: 220px; border: 4px solid #fff; margin-top: 10px; }\n  </style>\n</head>\n<body>\n  <h1>⚡ ZDOS // OMNI-NEXUS & VELVET SECURITY</h1>\n  <div class=\"card\">\n    <textarea id=\"blast\" placeholder=\"Messaggio da sparare su Canale WA OUR VELVET, La Loggia, Nova, @ourvelvet e X...\"></textarea>\n    <input id=\"sec\" type=\"password\" value=\"ZDOS2026\" style=\"width:100%;margin-top:6px;padding:6px;background:#050508;color:#fff;border:1px solid #3f3f5a;\">\n    <button onclick=\"send()\">🔥 AMPLIFICA SU TUTTI I NODI</button>\n    <div id=\"qr-box\"></div>\n  </div>\n  <div class=\"card\"><h3>TELEMETRIA LIVE</h3><div id=\"logs\"></div></div>\n  <script>\n    const s = io();\n    s.on(\"log\", m => { const d = document.createElement(\"div\"); d.textContent = m; document.getElementById(\"logs\").prepend(d); });\n    s.on(\"qr\", u => { document.getElementById(\"qr-box\").innerHTML = \"<p>Scansiona QR WhatsApp:</p><img src=\"+u+\">\"; });\n    async function send() {\n      const text = document.getElementById(\"blast\").value;\n      const secret = document.getElementById(\"sec\").value;\n      await fetch(\"/api/amplify\", { method:\"POST\", headers:{\"Content-Type\":\"application/json\"}, body: JSON.stringify({text, secret}) });\n      document.getElementById(\"blast\").value = \"\";\n    }\n  </script>\n</body>\n</html>\nEOF\n\n# 4. Crea nexus.js completo (Sicurezza + Gioco $OV + Bridge + Sparo Automatico all avvio)\ncat << \"EOF\" > nexus.js\nrequire(\"dotenv\").config();\nconst fs = require(\"fs\");\nconst crypto = require(\"crypto\");\nconst express = require(\"express\");\nconst http = require(\"http\");\nconst { Server } = require(\"socket.io\");\nconst QRCode = require(\"qrcode\");\nconst qrcodeTerm = require(\"qrcode-terminal\");\nconst { Client: WAClient, LocalAuth } = require(\"whatsapp-web.js\");\nconst { Client: DiscordClient, GatewayIntentBits } = require(\"discord.js\");\nconst TelegramBot = require(\"node-telegram-bot-api\");\n\nconst app = express();\nconst server = http.createServer(app);\nconst io = new Server(server);\napp.use(express.json());\napp.use(express.static(\"public\"));\n\nconst DB_FILE = \"./velvet_db.json\";\nlet db = fs.existsSync(DB_FILE) ? JSON.parse(fs.readFileSync(DB_FILE, \"utf8\")) : { users: {}, verified: {} };\ncon",
      "SUDO_USER": "root",
      "PWD": "/root",
      "LOGNAME": "root",
      "HOME": "/root",
