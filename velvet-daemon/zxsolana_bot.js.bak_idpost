  MISTRESS_SUPREMA: { name: "👑 Mistress Suprema · Loggia BDSM (NSWT-T)", color: 0xe5e4e2, admin: true },
  MASTER_SOVEREIGN: { name: "⚡ Master Sovereign · Architetto ZDOS", color: 0x9945ff, admin: true },
  AGI_NODE:         { name: "🤖 Nodo AGI · Velvet & z-xSOLANA Core", color: 0x00e5ff, admin: false },
  MISTRESS:         { name: "🔥 Mistress della Loggia 18+", color: 0xc41e3a, admin: false },
  MASTER:           { name: "⛓️ Master & Dom 18+", color: 0x8b0000, admin: false },
  SLAVE:            { name: "🩸 Slave · Sottomesso Verificato 18+", color: 0x4a0404, admin: false }
};

const TIER_TO_ROLE = {
  PLATINUM_SUPREMO: BDSM_HIERARCHY.MISTRESS_SUPREMA,
  SOVEREIGN_FOUNDER: BDSM_HIERARCHY.MASTER_SOVEREIGN,
  VIP_LOGGIA: BDSM_HIERARCHY.MISTRESS,
